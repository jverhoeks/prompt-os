{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-os.local/contracts/data-contract.schema.json",
  "title": "Generated application data contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "based_on", "summary", "collections", "open_questions"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "based_on": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "collections": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,62}$"},
      "additionalProperties": {"$ref": "#/$defs/collection"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "identity", "fields"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "identity": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 12,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,62}$"},
          "additionalProperties": {"$ref": "#/$defs/field"}
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "type", "required", "evidence"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["string", "integer", "number", "boolean", "datetime", "reference", "list"]
        },
        "required": {"type": "boolean"},
        "references": {"type": "string"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
