{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt OS document store tools",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "inputSchema"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "inputSchema": {"type": "object"}
        }
      }
    }
  },
  "tools": [
    {
      "name": "store.put",
      "description": "Create or replace a JSON document in a collection.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection", "document"],
        "properties": {
          "collection": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
          "id": {"type": "string"},
          "document": {"type": "object"}
        }
      }
    },
    {
      "name": "store.get",
      "description": "Read one document by identifier.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"type": "string"}}
      }
    },
    {
      "name": "store.query",
      "description": "Find non-archived documents using exact JSON field matches.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "collection": {"type": "string"},
          "where": {"type": "object"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500}
        }
      }
    },
    {
      "name": "store.scan",
      "description": "Read the most recently changed non-archived documents.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 500}}
      }
    },
    {
      "name": "store.archive",
      "description": "Soft-delete a document while preserving its audit history.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}

